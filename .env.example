# ============================================
# AMIRMIND AI - Environment Configuration
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/amirmind_dev"
DATABASE_SHADOW_URL="postgresql://user:password@localhost:5432/amirmind_shadow"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRE_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRE_IN="30d"

# ============================================
# OAUTH PROVIDERS
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ============================================
# API PROVIDERS (AI MODELS)
# ============================================

# OpenAI (ChatGPT)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-opus-20240229"

# Google (Gemini)
GOOGLE_GENERATIVE_AI_KEY="..."
GEMINI_MODEL="gemini-pro"

# Perplexity
PERPLEXITY_API_KEY="pplx-..."
PERPLEXITY_MODEL="llama-2-70b-chat"

# Groq
GROQ_API_KEY="gsk_..."
GROQ_MODEL="mixtral-8x7b-32768"

# OpenRouter
OPENROUTER_API_KEY="sk-or-..."

# Image Generation (Nano Banana / DALL-E)
NANO_BANANA_API_KEY="..."
DALL_E_API_KEY="..."

# Video Generation (Flow)
FLOW_API_KEY="..."

# ============================================
# EMAIL SERVICE
# ============================================
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="noreply@amirmind.ai"
SMTP_PASS="..."
SMTP_FROM="noreply@amirmind.ai"
SMTP_FROM_NAME="AmirMind AI"

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AmirMind AI"
NEXT_PUBLIC_OWNER_NAME="NIZOMOV AMIRBEK"

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-..."
NEXT_PUBLIC_SENTRY_DSN="..."

# ============================================
# BACKEND CONFIGURATION
# ============================================
API_PORT=3001
API_HOST="0.0.0.0"
API_PREFIX="/api"

# CORS
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_UPLOAD_SIZE="104857600" # 100MB
ALLOWED_UPLOAD_TYPES="pdf,doc,docx,xls,xlsx,csv,json,txt,md"

# ============================================
# SECURITY
# ============================================
ENCRYPTION_KEY="your-encryption-key-32-characters-long"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="debug"
LOG_FORMAT="json" # json or text

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN="..."
DATADOG_API_KEY="..."
NEW_RELIC_LICENSE_KEY="..."

# ============================================
# DEPLOYMENT
# ============================================
DEPLOY_ENVIRONMENT="development" # development, staging, production
DEPLOY_REGION="us-east-1"

# Cloudflare
CLOUDFLARE_ZONE_ID="..."
CLOUDFLARE_API_TOKEN="..."

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_IMAGE_STUDIO="true"
FEATURE_VIDEO_STUDIO="false"
FEATURE_KNOWLEDGE_MAP="false"
FEATURE_ADMIN_PANEL="true"
FEATURE_WEBHOOKS="false"

# ============================================
# DEVELOPMENT
# ============================================
DEBUG="amirmind:*"
DEVELOPMENT_MODE="true"
MOCK_PROVIDERS="false" # Set to true to mock AI responses
